    public void doubleRotateFromLeft(Node y) {
        // Pls copy the code from the previous problem
        if (y == null || y.left == null || y.left.right == null) {
            return;//ถ้าไม่มี node y,x,z ให้ return ออก
        }
        Node x = y.left;//ให้ node x เป็นลูกด้านซ้าย y
        Node z = y.left.right;//ให้ node z เป็นลูกขวา x
        Node w = y.parent;//ให้ node w เป็น parent y
        if(z.left != null){//ถ้า node z มีลูกด้านซ้าย
            x.right = z.left;//ให้ลูกด้านซ้าย z เป็นลูกด้านขวา x
            x.right.parent = x;//ผูก parent ให้ลูก x
        }else{//ถ้า node z ไม่มีลูกด้านซ้าย
            x.right = null;//ลบเส้นขวา x
        }
        if(z.right != null){//ถ้า node z มีลูกด้านขวา
            y.left = z.right;//ให้ลูกด้านขวา z เป็นลูกด้านซ้าย y
            y.left.parent = y;//ผูก parent ให้ลูก y
        }else{//ถ้า node z ไม่มีลูกด้านขวา
            y.left = null;//ลบเส้นซ้าย y
        }
        z.right = y;//ให้ลูกขวา z เป็น node y
        y.parent = z;//ผูก parent ให้ลูก z
        z.left = x;//ให้ลูกซ้าย z เป็น node x
        x.parent = z;//ผูก parent ให้ลูก z
        if(w == null){//ถ้า node ที่ต้องการหมุนเป็น root node
            root = z;//เปลี่ยน root node เป็น node z
            z.parent = null;//ลบ parent ของ root node
        }else if(z.key < w.key){//ถ้า z เดิมอยู่ซ้าย w
            w.left = z;//เปลี่ยนลูกด้านซ้าย w ใหม่
            z.parent = w;//ผูก parent ให้ลูก w
        }else{//ถ้า x เดิมอยู่ขวา w
            w.right = z;//เปลี่ยนลูกด้านขวา w ใหม่
            z.parent = w;//ผูก parent ให้ลูก w
        }
    }

    public void doubleRotateFromRight(Node y) {
        // Pls copy the code from the previous problem
        if (y == null || y.right == null || y.right.left == null) {
            return;//ถ้าไม่มี node y,x,z ให้ return ออก
        }
        Node x = y.right;//ให้ node x เป็นลูกด้านขวา y
        Node z = y.right.left;//ให้ node z เป็นลูกซ้าย x
        Node w = y.parent;//ให้ node w เป็น parent y
        if(z.right != null){//ถ้า node z มีลูกด้านขวา
            x.left = z.right;//ให้ลูกด้านขวา z เป็นลูกด้านซ้าย x
            x.left.parent = x;//ผูก parent ให้ลูก x
        }else{//ถ้า node z ไม่มีลูกด้านขวา
            x.left = null;//ลบเส้นซ้าย x
        }
        if(z.left != null){//ถ้า node z มีลูกด้านซ้าย
            y.right = z.left;//ให้ลูกด้านซ้าย z เป็นลูกด้านขวา y
            y.right.parent = y;//ผูก parent ให้ลูก y
        }else{//ถ้า node z ไม่มีลูกด้านซ้าย
            y.right = null;//ลบเส้นขวา y
        }
        z.left = y;//ให้ลูกซ้าย z เป็น node y
        y.parent = z;//ผูก parent ให้ลูก z
        z.right = x;//ให้ลูกขวา z เป็น node x
        x.parent = z;//ผูก parent ให้ลูก z
        if(w == null){//ถ้า node ที่ต้องการหมุนเป็น root node
            root = z;//เปลี่ยน root node เป็น node z
            z.parent = null;//ลบ parent ของ root node
        }else if(z.key < w.key){//ถ้า z เดิมอยู่ซ้าย w
            w.left = z;//เปลี่ยนลูกด้านซ้าย w ใหม่
            z.parent = w;//ผูก parent ให้ลูก w
        }else{//ถ้า x เดิมอยู่ขวา w
            w.right = z;//เปลี่ยนลูกด้านขวา w ใหม่
            z.parent = w;//ผูก parent ให้ลูก w
        }
    }

    public static void rebalance(AVLTree tree, Node node){
        // Pls copy the code from the previous problem
        int balanceFactor = height(node.left) - height(node.right);//ความสูงซ้าย - ขวา
        if (balanceFactor > 1 || balanceFactor < -1){//ถ้าความสูงต่างกันเกิน 1 ไม่ balance
            if (balanceFactor > 1){//ถ้ามากกว่า 1 หนักขวา
                if (height(node.left.left) > height(node.left.right)){//ถ้า node granchild ไหนมีความสูงมากกว่าแสดงว่า node พังที่ node นั้น
                    System.out.println("Perform SingleRotationFromLeft(Node " + node.key +")");   // Fix ??? and call a function
                    tree.singleRotateFromLeft(node);//outer case LL
                }else{
                    System.out.println("Perform DoubleRotationFromLeft(Node " + node.key +")");   // Fix ??? and call a function
                    tree.doubleRotateFromLeft(node);//inner case LR
                }
            }else{//ถ้าน้อยกว่า -1 หนักซ้าย
                if (height(node.right.right) > height(node.right.left)){//ถ้า node granchild ไหนมีความสูงมากกว่าแสดงว่า node พังที่ node นั้น
                    System.out.println("Perform SingleRotationFromRight(Node " + node.key +")");   // Fix this and call a function
                    tree.singleRotateFromRight(node);//outer case RR
                }else{
                    System.out.println("Perform DoubleRotationFromRight(Node " + node.key +")");   // Fix this and call a function
                    tree.doubleRotateFromRight(node);//inner case RL
                }
            }
        }
    }
    
    // This function is for deleting the root node
    // If the node is not the root, please call the recursive version
    public void deleteKey(int key) {
        // Pls copy the code from the previous homework
      if(root == null){
          System.out.println("Empty Tree!!!");//ไม่มี root เป็น empty tree
          return;
      }
      if(root.key == key){//ถ้าตัวที่ต้องการลบเป็น node
          if(root.right == null && root.left == null){//กรณีไม่มีลูก
              root = null;//ลบ root node
          }else if(root.left == null){//กรณีมีลูกด้านซ้ายตัวเดียว
              root = root.right;//เปลี่ยนให้ลูกด้านซ้ายเป็น root node
              root.parent = null;
              rebalance(this,root);//rebalance root node
          }else if(root.right == null){//กรณีมีลูกด้านขวาตัวเดียว
              root = root.left;//เปลี่ยนให้ลูกด้านขวาเป็น root node
              root.parent = null;
              rebalance(this,root);//rebalance root node
          }else{//กรณีมีครบ 2 ตัว
              Node minRST = findMin(root.right);//หา min ของ subtree ด้านขวา
              root.key = minRST.key;//เปลี่ยนค่า root node เป็นค่าของ min right subtree
              deleteKey(this,minRST);//ใช้ static funtion ลบ node minRST
          }
      }else{//ถ้าไม่ใช่ node
          Node target = findKey(key);//หา node ใน tree
          if(target == null){
              System.out.println("Key not found!!!");//กรณีไม่เจอตัวที่ต้องการลบ
          }else{
              deleteKey(this,target);//ใช้ static funtion ลบ node นั้น
          }
      }
    }
    
    // Use this function to delete non-root nodes
    // Also, fix the code to have the rebalancing feature
    public static void deleteKey(AVLTree tree, Node node){
        // Pls copy the code from the previous homework
        // Add code segments to enable the rebalancing feature
      Node parent = node.parent;//กำหนด node parent ของ node ที่ต้องการลบ
      if(node.right == null && node.left == null){//กรณี node ต้องลบไม่มีลูก
          if(node.key < parent.key){//ถ้าค่า node นั้นน้อยกว่า parent
              parent.left = null;//ลบ node นั้นจากลบ node ซ้าย parent
          }else{
              parent.right = null;//ลบ node นั้นจากลบ node ขวา parent
          }
      }else if(node.left == null){//กรณี node ที่ต้องการลบไม่มีลูกด้านซ้าย
          Node child = node.right;//node ลูกด้านซ้าย
          if(node.key < parent.key){//ถ้าค่า node นั้นน้อยกว่า parent
              parent.left = child;//ให้ node ซ้าย parent เป็น node ลูกด้านขวา
          }else{
              parent.right = child;//ให้ node ขวา parent เป็น node ลูกด้านขวา
          }
          child.parent = parent;//กำหนด parent ใหม่ให้ node ลูก
      }else if(node.right == null){//กรณี node ที่ต้องการลบไม่มีลูกด้านขวา
          Node child = node.left;//node ลูกด้านขวา
          if(node.key < parent.key){//ถ้าค่า node นั้นน้อยกว่า parent
              parent.left = child;//ให้ node ซ้าย parent เป็น node ลูกด้านขวา
          }else{
              parent.right = child;//ให้ node ขวา parent เป็น node ลูกด้านขวา
          }
          child.parent = parent;//กำหนด parent ใหม่ให้ node ลูก
      }else{
          Node minRST = findMin(node.right);//หา min ของ subtree ด้านขวา
          node.key = minRST.key;//เปลี่ยนค่า node ที่ต้องการลบเป็นค่าของ min right subtree
          deleteKey(tree,minRST);//ใช้ static funtion ลบ node minRST
      }
      while(parent != null){//วนจนกว่าถึง root
          rebalance(tree,parent);//rebalance parent ทุกตัว
          parent = parent.parent;//ไต่ parent ขึ้นไป
      }
    }
    

