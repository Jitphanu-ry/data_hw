    public static int polyHash(String s, int p, int x){
        // Pls use code from the previous problem
        int hash = 0;
        for (int i = s.length() - 1; i >= 0; i--) {//เริ่มจากตัวสุดท้ายถึงตัวแรก
            hash = (hash * x + (int)s.charAt(i)) % p;//วนลูปคิดค่า hash จาก ASCII ของ char ใน string
        }
        return hash;//return ค่า hashที่ยังไม่ได้ mod m
    }
    
    public int getListIndex(String s){
        // Pls use code from the previous problem
        int cap = vertexList.length;//ให้ cap เป็ยขนาดของ array
        int initial = polyHash(s, p, x);//แล้ว initial เป็นค่าที่ hash ได้
        
        for(int i=0;i<cap;i++){//quadratic probing
            int index = (initial + (i + i*i)/2) % cap;//ให้ index เป็นค่าที่คำนวนโดยการนำผลลัพธ์จากการ hash มา +(k+k^2)/2 แล้วหาร cap ถ้า cap = 2^n แล้วจะวนได้ครบทุก index
            if(vertexList[index] == null || vertexList[index].strKey.equals(s)){//ถ้า index นั้นว่างหรือซ้ำ
                return index;//return index นั้น
            }//ยังไม่เจอที่ว่าให้วนไปจนครบ
        }
        return -1;//มี string ในทุก index หรือ array เต็มแล้ว return -1
    }
    
    
    public void addVertex(String key){
        if (size==cap){
            System.out.println("Vertex list is full. You need to recreate the Graph");
            return;
        }
        
        // Map the String key to the array index (use getListIndex())
        // Pls use code from the previous problem as the starter
        int index = getListIndex(key);//หา index จาก getlistindex
        if(index != -1){//array ยังไม่เต็ม
            vertexList[index] = new Vertex(key);//สร้าง vertex ใหม่ ใส่ลงใน array
            adjacencyList[index] = new LinkedList();//สร้าง linkedlist ของ vertex นั้น
            size++;   
        }
    }
    
    public void addEdge(String source, String destination){
        // Map String's source and destination (city name) to Integer's u, v (array index)
        // You may call super.addEdge(u, v); for simpler implementation
        int u = getListIndex(source);//get index ปลายทาง
        int v = getListIndex(destination);//get index ต้นทาง
        super.addEdge(u,v);//เชื่อม edge
    }
    

    public void BFS(Vertex s){
        // Set all Vertex.dist to Infinity (Use Integer.MAX_VALUE to represent Infinity)
        for(int i=0;i<vertexList.length;i++){
            if (vertexList[i] != null) {//เจอ vertex
                vertexList[i].dist = Integer.MAX_VALUE;//ให้ระยะทุก vertex มีค่ามากๆ
                vertexList[i].prev = null;//ลบ pointer ที่ชี้ตัวก่อนหน้า
            }
        }
        // Set dist of the start vertex (s) to 0
        // Push the start vertex to an empty queue
        s.dist = 0;//set ระยะ vertex s เป็น 0
        Queue<Vertex> Q = new LinkedList<>();//สร้าง queue
        Q.add(s);//นำ vertex s เข้าไปใน queue
        // [*] Check if the queue is not empty
        // Pop the queue, and get the current vertex
        // Extract the list of all vertices that are connected to current vertex
        while(!Q.isEmpty()){//ถ้า queue ไม่ว่าง
            Vertex u = Q.poll();//เอา dequeue vertex
            int uIndex = getListIndex(u.strKey);//หา index vertex นั้น
            if(uIndex != -1){//หาเจอ
                LinkedList<Integer> list = adjacencyList[uIndex];//เอา list ของ vertex ออกมา
                for(int vIndex : list){//ดูทุกตัวที่ติดกับ vertex นั้น
                    Vertex v = vertexList[vIndex];//เอา neighbor ออกมาทีละตัว
                    if(v.dist == Integer.MAX_VALUE){//ถ้าระยะ neighbor มีค่ามากๆ
                        v.dist = u.dist + 1;//ให้ระยะ neightbor เป็นค่าของระยะ u+1
                        v.prev = u;//ตัวก่อนหน้า neightbor เป็น u
                        Q.add(v);//แล้วนำ v เอาไปใน Q จากนั้นวนลูปจนไม่มีเจอ u ใน list
                    }
                }
            }
        }
