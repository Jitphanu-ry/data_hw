        //          increase the dist variable of that vertex by one
        //          set the prev variable of that vertex to the current vertex
        
        // Repeat [*]
    }

    
    public Stack<Vertex> getShortestPathList(Vertex S, Vertex U){
        
        // Create a stack
        Stack<Vertex> stack = new Stack<>();//สร้าง stack
        // Start from city U
        Vertex current = U;//เริ่มจาก vertex U
        // [*] push the current city into the stack
        while(current != null){
            stack.push(current);//นำ vertex ที่ดูอยู่เข้า stack
            if(current == S){
                break;//เจอปลายทางแล้วออกจาก loop
            }
            current = current.prev;//ชี้ย้อนไปจาก U ไป S
        }
        // Go back one city using U.prev
        // Repeat [*] until you reach the city S
        // return the stack
        return stack;//return stack
    }
    
    public void printShortestPath(String s_str, String u_str){
        
        // Map city names to index numbers
        // Get vertices from the vertexList
        // Run BFS() at the starting city
        // Get shortestPartList(starting city, ending city)
        // Traverse all the stack and print the city name
        int sIndex = getListIndex(s_str);//หา index จาก getlistindex
        int uIndex = getListIndex(u_str);//หา index จาก getlistindex
        if(sIndex == -1 || uIndex == -1){//ถ้าไม่เจอ return ออก
            return;
        }
        Vertex S = vertexList[sIndex];//นำ vertex S มาจาก list
        Vertex U = vertexList[uIndex];//นำ vertex U มาจาก list
        BFS(S);//run BFS หาระยะห่างระหว่าง vertex S กับทุก vertex
        Stack<Vertex> path = getShortestPathList(S,U);//หาทางที่ใกล้ที่สุดจาก vertex S ไป U แล้วเอา vertex มาใส่ใน path
        while(!path.isEmpty()){//print ทุกตัวที่ผ่านมาเจอ
            System.out.print(path.pop().strKey);
            System.out.print(" -> ");
        }
    }
    
