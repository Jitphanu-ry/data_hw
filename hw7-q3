    public static void insertKey(AVLTree tree, Node node, int key) {
        if (key == node.key) {
            System.out.println("Duplicated key:" + key);
        }else if (key < node.key) {//Go left
            if (node.left == null) {//ถ้าไม่มี node
                node.left = new Node(key);//เพิ่ม node
                node.left.parent = node;//ผูก parent
            }else {
                insertKey(tree, node.left, key);//ลงไป node ขวา
            }
        }else{  // Go right
            if (node.right == null) {//ถ้าไม่มี node
                node.right = new Node(key);//เพิ่ม node
                node.right.parent = node;//ผูก parent
            }else {
                insertKey(tree, node.right, key);//ลงไป node ซ้าย
            }
        }
        rebalance(tree,node);//rebalance ตอนออกจาก stack
    }
    
    // This function is complete, no need to edit
    public void insertKey(int key) {
        if (root == null) {
            root = new Node(key);
        } else {
            insertKey(this, root, key);
        }
    }
    
