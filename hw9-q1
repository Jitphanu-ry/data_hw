    public static void queueTest(){
        // Create a queue object that can contain String's
        // Name the varible to q
        Queue<String> q = new LinkedList<>();//สร้าง queue โดยใช้ linkedlist
        
        String[] names = {"Abraham","Andrew","Benjamin","Claudia","Gabriel"};
        for (int i=0; i<names.length; i++){
            // Add names[i] to the queue object (q)
            q.add(names[i]);//loop ใส่ชื่อลงไปใน queue
        }
            
        System.out.println("Top = " + q.peek());//top queue โดยไม่นำ object ออก queue
        System.out.println("1st Pop = " + q.poll());//dequeue แล้วแสดงค่า
        System.out.println("2nd Pop = " + q.poll());//dequeue แล้วแสดงค่า
        System.out.println("3rd Pop = " + q.poll());//dequeue แล้วแสดงค่า
    }
        
    public static void stackTest(){
        // Create a stack of object that can contain String's
        // Name the varible to s
        Stack<String> s = new Stack<>();//สร้าง stack
        
        String[] names = {"Abraham","Andrew","Benjamin","Claudia","Gabriel"};
        for (int i=0; i<names.length; i++){
            // Push names[i] into the stack object (s)
            s.push(names[i]);//นำข้อมูลเข้า stack
        }
            
        System.out.println("Top = "+ s.peek());//top stack โดยไม่เอาข้อมูลออก
        System.out.println("1st Pop = "+ s.pop());//pop stack แสดงค่า
        System.out.println("2nd Pop = "+ s.pop());//pop stack แสดงค่า
        System.out.println("3rd Pop = "+ s.pop());//pop stack แสดงค่า
    }
        
        
