public class Tree extends BTreePrinter{ // ให้ node สืบสมบัติจาก BTreePrinter
  Node root;
    
  public Tree(Node root){
      // fix this
      this.root = root;//กำหนดค่า root
  }
  
  public void printTree(){
      if(root != null){
        super.printTree(root);//ถ้ามี root nodeprint node ใน tree ทั้งหมด
      }else{
        System.out.println("Empty tree!!!");
      }
  }

  public Node findKey(int search_key){
      if(root == null){
          return null;//ไม่ root node ไม่เรียกฟังชั่น
      }else{
          return findKey(root,search_key); // Call the recursive version
      }
  }
  
  public static Node findKey(Node node, int search_key){
      // this function should be recursive
      // You should check null in this function
        if(node == null){
            return null;//หา search key ไม่เจอ
        }
        if(search_key == node.key){
          return node;//ถ้าเจอ search_key แล้วให้ return node นั้น
        }else{
            if(search_key < node.key){
                return findKey(node.left,search_key);//ถ้า search key น้อยกว่า node ที่ชี้อยู่ให้ลงไปดู node ซ้าย
            }else{
                return findKey(node.right,search_key);//ถ้ามากกว่าให้ลงไปดู node ขวา
            }
        }
   }
  
  public Node findMin(){
    if(root == null){
        return null;//ไม่ root node ไม่เรียกฟังชั่น
    }else{
        return findMin(root); // Call the recursive version
    }
  }
  
  public static Node findMin(Node node){
      // this function should be recursive
    if(node == null){
        return null;//ไม่มี root node
    }
    if(node.left != null){
        return  findMin(node.left);//ถ้ามี node ซ้ายอยู่ให้ชี้ลงไปตัวซ้ายเรื่อยๆจนถึงตัวสุดท้าย
    }else{
        return node;//return ค่าตัวซ้ายสุด
        }
    }
  
  public Node findMax(){
    if(root == null){
        return null;//ไม่ root node ไม่เรียกฟังชั่น
    }else{
        return findMax(root); // Call the recursive version
        }
    }
  
  public static Node findMax(Node node){
      // this function should be recursive
      if(node == null){
        return null;//ไม่มี root node
      }
      if(node.right != null){
          return findMax(node.right);//ถ้ามี node ขวาอยู่ให้ชี้ลงไปตัวขวาเรื่อยๆจนถึงตัวสุดท้าย
      }else{
          return node;//return ค่าตัวขวาสุด
    }
  }
  
  public Node findClosestLeaf(int search_key){
    if(root == null){
        return null;//ไม่ root node ไม่เรียกฟังชั่น
    }else{
        return findClosestLeaf(root,search_key); // Call the recursive version
    }
  }
  
  public static Node findClosestLeaf(Node node, int search_key){
      // this function should be recursive
      if(search_key < node.key){//ถ้า search key น้อยกว่า current ดู node ซ้าย
            if(node.left != null){
                return findClosestLeaf(node.left,search_key);//ถ้า node ด้านซ้ายให้ลงไปดู node ด้านซ้าย
            }else{
            return node;//ถ้าไม่มี node ด้านซ้ายแล้วแสดงว่า node นั้นเป็น closest Leaf
            }
        }else{//ถ้าเกิดมากกว่าให้ดูขวา
            if(node.right != null){
              return findClosestLeaf(node.right,search_key);//ถ้า node ด้านขวาให้ลงไปดู node ด้านขวา
            }else{
              return node;//ถ้าไม่มี node ด้านขวาแล้วแสดงว่า node นั้นเป็น closest 
            }
        }
  }
  
  public Node findClosest(int search_key){
      // Please use while loop to implement this function
      // Try not to use recursion
      
      Node current, closest;//สร้าง node current กับ closest ไว้เก็บตัวแปร node
      closest = current = root;
      int min_diff = Integer.MAX_VALUE;//กำหนดค่าผลต่างน้อยสุดให้มีค่ามากไว้ก่อน
      
      // Use while loop to traverse from root to the closest leaf
      while(current != null){//loop จนกว่า current เป็น null
          int diff = Math.abs(search_key - current.key);//ให้ค่า diff เป็นผลต่างของ search key กับค่า current node
          if(diff < min_diff){//ถ้าผลต่างน้อยสุด น้อยกว่าค่าผลต่าง
            min_diff = diff;//กำหนดค่า diff เป็นผลต่างน้อยสุด
            closest = current;//closest node เป็น current node ที่ดูกว่า
          }
          
          if(search_key < current.key){//ถ้า search key มีค่าน้อยกว่า current
              current = current.left;//ลงไปด้านกว่า
          }else{
              current = current.right;//มากกว่าลงไปด้านซ้าย
          }
      }
      
      return closest;//return ผลลัพธ์เป็น closest node
  }
  
  // Print node's key
  public static void printNode(Node node){
      if(node != null){
        System.out.println(node.key);//ถ้ามี node นั้นทำการ print
      }else{
        System.out.println("Node not found!!!");
      }
  }
  
  public Tree(){} // Dummy constructor (No need to edit)
}
