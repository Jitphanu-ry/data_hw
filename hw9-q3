    public void showAdjacentVertices(int u){
        Vertex v = vertexList[u];
        System.out.print("Vertex " + v.strKey + " connected to the following vertices: ");
        
        LinkedList<Integer> list = adjacencyList[u];
        for (int vertex_index : list) {
            System.out.print(vertexList[vertex_index].strKey + ", ");
        }
        System.out.println();
    }  
    
    public void Explore(Vertex v){
        
        // Mark this vertex for visited
        v.visited = true;//set vertex นี้ visit แล้ว
        // Stamp the current cc number to this vertex (ccNum)
        v.ccNum = cc;//ให้อยู่ใน connet compent ที่ดูอยู่
        
        // Print vertex
        System.out.print(v.strKey +"/"+v.ccNum+" -> ");
        
        
        // Extract the list of all vertices that are connected to Vertex v
        int index = -1;//กำหนด index เป็น 1
        for(int i = 0; i < size; i++){
            if(vertexList[i] == v){//หา vertex v อยู่ตรงไหนใน vertexlist
                index = i;//กำหนดค่า index ของ vertex v
                break;
            }
        }
        // Traverse all the list check if anyone are already visited or not
        // If no, then explore the vertex
        if(index != -1){//ถ้ามี index
            LinkedList<Integer> list = adjacencyList[index];//เอา list ของ vertex v ออกมา
            for(int neighborIndex : list){//ทุก vertex ใน list (ติดกับ v)
                Vertex neighbor = vertexList[neighborIndex];//ดูที่ละ vertex
                if(!neighbor.visited){
                    Explore(neighbor);//ถ้ายังไม่ explore ก็ explore vertex นั้น
                }
            }
        }
    }
    
    public void DFS(){
        
        // Set cc (connected component number) to 1
        cc = 1;//กำหนด cc เป็น 1
        // Check all vertices if they are visited or not
        // If no, then explore the vertex, then increase cc by 1
        for(int i=0;i<size;i++){
            if(vertexList[i] != null){//ถ้ามี vertex นั้นอยู่ใน vertexlist
                vertexList[i].visited = false;//mark ทุก vertex ให้ยังไม่ visited
            }
        }
        for(int i=0;i<size;i++){
            if(!vertexList[i].visited){//ถ้ายังไม่ได้ visit ไป explore vertex นั้น
                Explore(vertexList[i]);//explore vertex ทุกตัวใน vertexlist
                cc++;//explore เสร็จเพิ่ม cc เพื่อแบ่งกลุ่มที่เชื่อมกัน
            }//ถ้ามีกลุ่มแล้วแสดงว่า visited
        }
        
        System.out.println();
    }
    
    
